CREATE TRIGGER sync_track_medications_delete AFTER DELETE ON medications
WHEN EXISTS (SELECT 1 FROM sync_settings
    WHERE household_id IS NOT NULL AND applying = 0)
  AND (EXISTS (SELECT 1 FROM sync_shared_members WHERE member_id = OLD.member_id)
    OR EXISTS (SELECT 1 FROM sync_records
      WHERE kind = 'medication' AND sync_id = OLD.id))
BEGIN
  INSERT OR IGNORE INTO sync_pending (kind, sync_id, local_id, change_count)
    VALUES ('medication', OLD.id, OLD.id, 0);
  UPDATE sync_pending SET change_count = change_count + 1, local_id = OLD.id
    WHERE kind = 'medication' AND sync_id = OLD.id;
END;

CREATE TRIGGER sync_track_dose_records_insert AFTER INSERT ON dose_records
WHEN EXISTS (SELECT 1 FROM sync_settings
    WHERE household_id IS NOT NULL AND applying = 0)
  AND (EXISTS (SELECT 1 FROM sync_shared_members WHERE member_id = NEW.member_id)
    OR EXISTS (SELECT 1 FROM sync_records
      WHERE kind = 'dose' AND sync_id = NEW.medication_id || '@' || NEW.scheduled_at))
BEGIN
  INSERT OR IGNORE INTO sync_pending (kind, sync_id, local_id, change_count)
    VALUES ('dose', NEW.medication_id || '@' || NEW.scheduled_at, NEW.id, 0);
  UPDATE sync_pending SET change_count = change_count + 1, local_id = NEW.id
    WHERE kind = 'dose' AND sync_id = NEW.medication_id || '@' || NEW.scheduled_at;
END;

CREATE TRIGGER sync_track_dose_records_update AFTER UPDATE ON dose_records
WHEN EXISTS (SELECT 1 FROM sync_settings
    WHERE household_id IS NOT NULL AND applying = 0)
  AND (EXISTS (SELECT 1 FROM sync_shared_members WHERE member_id = NEW.member_id)
    OR EXISTS (SELECT 1 FROM sync_shared_members WHERE member_id = OLD.member_id)
    OR EXISTS (SELECT 1 FROM sync_records
      WHERE kind = 'dose' AND sync_id = NEW.medication_id || '@' || NEW.scheduled_at))
BEGIN
  INSERT OR IGNORE INTO sync_pending (kind, sync_id, local_id, change_count)
    VALUES ('dose', NEW.medication_id || '@' || NEW.scheduled_at, NEW.id, 0);
  UPDATE sync_pending SET change_count = change_count + 1, local_id = NEW.id
    WHERE kind = 'dose' AND sync_id = NEW.medication_id || '@' || NEW.scheduled_at;
END;

CREATE TRIGGER sync_track_dose_records_delete AFTER DELETE ON dose_records
WHEN EXISTS (SELECT 1 FROM sync_settings
    WHERE household_id IS NOT NULL AND applying = 0)
  AND (EXISTS (SELECT 1 FROM sync_shared_members WHERE member_id = OLD.member_id)
    OR EXISTS (SELECT 1 FROM sync_records
      WHERE kind = 'dose' AND sync_id = OLD.medication_id || '@' || OLD.scheduled_at))
BEGIN
  INSERT OR IGNORE INTO sync_pending (kind, sync_id, local_id, change_count)
    VALUES ('dose', OLD.medication_id || '@' || OLD.scheduled_at, OLD.id, 0);
  UPDATE sync_pending SET change_count = change_count + 1, local_id = OLD.id
    WHERE kind = 'dose' AND sync_id = OLD.medication_id || '@' || OLD.scheduled_at;
END;
