-- MyDr local database, schema version 4 (v2 added visit_media; v3 added
-- medications and dose_records; v4 added the sync_* tables and triggers for
-- household sharing).
--
-- Mirrors the models in lib/data/models exactly. Formats:
--   * local date and time: 'YYYY-MM-DDTHH:MM:SS.ffffff' (wall-clock time,
--     no time zone, so a time zone or DST change never moves it);
--   * date: 'YYYY-MM-DD';
--   * instant: microseconds since the Unix epoch;
--   * lists: a JSON array of strings.
-- See storage_codecs.dart.
--
-- Foreign keys restrict: a family member or appointment can only be
-- deleted once nothing refers to it any more, so no record is ever left
-- pointing at nothing.

CREATE TABLE family_members (
  id TEXT NOT NULL PRIMARY KEY CHECK (length(id) > 0),
  name TEXT NOT NULL CHECK (length(trim(name)) > 0),
  relation TEXT NOT NULL CHECK (relation IN
    ('self', 'spouse', 'child', 'parent', 'sibling', 'grandparent', 'other')),
  birth_date TEXT CHECK (birth_date IS NULL OR (length(birth_date) = 10
    AND birth_date GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]')),
  allergies TEXT NOT NULL DEFAULT '[]'
    CHECK (json_valid(allergies) AND json_type(allergies) = 'array'),
  chronic_conditions TEXT NOT NULL DEFAULT '[]'
    CHECK (json_valid(chronic_conditions)
      AND json_type(chronic_conditions) = 'array'),
  notes TEXT
) STRICT AS FamilyMemberRow;

-- At most one "self" profile.
CREATE UNIQUE INDEX family_members_single_self
  ON family_members (relation) WHERE relation = 'self';

CREATE TABLE appointments (
  id TEXT NOT NULL PRIMARY KEY CHECK (length(id) > 0),
  member_id TEXT NOT NULL
    REFERENCES family_members (id) ON DELETE RESTRICT ON UPDATE RESTRICT,
  doctor_name TEXT NOT NULL CHECK (length(trim(doctor_name)) > 0),
  scheduled_at TEXT NOT NULL CHECK (length(scheduled_at) = 26 AND scheduled_at GLOB
    '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9].[0-9][0-9][0-9][0-9][0-9][0-9]'),
  specialty TEXT,
  location TEXT,
  notes TEXT,
  -- Target of the composite key in doctor_questions.
  UNIQUE (id, member_id)
) STRICT AS AppointmentRow;

CREATE INDEX appointments_by_member ON appointments (member_id, scheduled_at);

CREATE TABLE doctor_questions (
  id TEXT NOT NULL PRIMARY KEY CHECK (length(id) > 0),
  member_id TEXT NOT NULL
    REFERENCES family_members (id) ON DELETE RESTRICT ON UPDATE RESTRICT,
  -- Null for a general question.
  appointment_id TEXT,
  question_text TEXT NOT NULL CHECK (length(trim(question_text)) > 0),
  created_at INTEGER NOT NULL,
  is_resolved INTEGER NOT NULL DEFAULT 0 CHECK (is_resolved IN (0, 1)),
  doctor_answer TEXT,
  -- A linked appointment must belong to the same family member.
  FOREIGN KEY (appointment_id, member_id)
    REFERENCES appointments (id, member_id)
    ON DELETE RESTRICT ON UPDATE RESTRICT
) STRICT AS DoctorQuestionRow;

CREATE INDEX doctor_questions_by_member
  ON doctor_questions (member_id, created_at);
CREATE INDEX doctor_questions_by_appointment
  ON doctor_questions (appointment_id);

CREATE TABLE symptom_entries (
  id TEXT NOT NULL PRIMARY KEY CHECK (length(id) > 0),
  member_id TEXT NOT NULL
    REFERENCES family_members (id) ON DELETE RESTRICT ON UPDATE RESTRICT,
  name TEXT NOT NULL CHECK (length(trim(name)) > 0),
  -- The name as compared for grouping (trimmed, single spaces, lower case).
  name_key TEXT NOT NULL CHECK (length(name_key) > 0),
  started_at TEXT NOT NULL CHECK (length(started_at) = 26 AND started_at GLOB
    '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9].[0-9][0-9][0-9][0-9][0-9][0-9]'),
  severity INTEGER NOT NULL CHECK (severity BETWEEN 1 AND 5),
  status TEXT NOT NULL DEFAULT 'ongoing'
    CHECK (status IN ('ongoing', 'resolved')),
  duration_micros INTEGER
    CHECK (duration_micros IS NULL OR duration_micros >= 0),
  notes TEXT
) STRICT AS SymptomEntryRow;

CREATE INDEX symptom_entries_by_group
  ON symptom_entries (member_id, name_key, started_at);

-- Photos and videos documenting symptoms for a doctor visit. Only the
-- metadata is stored here; the media file itself lives in the app's private
-- directory under file_name (see visit_media_file_store.dart).
CREATE TABLE visit_media (
  id TEXT NOT NULL PRIMARY KEY CHECK (length(id) > 0),
  member_id TEXT NOT NULL
    REFERENCES family_members (id) ON DELETE RESTRICT ON UPDATE RESTRICT,
  appointment_id TEXT NOT NULL,
  kind TEXT NOT NULL CHECK (kind IN ('photo', 'video')),
  -- A bare file name inside the private media directory, never a path.
  file_name TEXT NOT NULL UNIQUE CHECK (length(file_name) > 0
    AND file_name NOT GLOB '*[/\]*' AND file_name NOT GLOB '.*'),
  byte_size INTEGER NOT NULL CHECK (byte_size > 0),
  description TEXT,
  created_at INTEGER NOT NULL,
  -- The appointment must belong to the same family member, so a member's
  -- documentation can never show up under another member.
  FOREIGN KEY (appointment_id, member_id)
    REFERENCES appointments (id, member_id)
    ON DELETE RESTRICT ON UPDATE RESTRICT
) STRICT AS VisitMediaRow;

CREATE INDEX visit_media_by_appointment
  ON visit_media (appointment_id, created_at);
CREATE INDEX visit_media_by_member ON visit_media (member_id);

-- Medications a family member takes, as the user entered them. Reminders
-- are not stored: they are planned from these rows (see
-- reminder_planner.dart).
CREATE TABLE medications (
  id TEXT NOT NULL PRIMARY KEY CHECK (length(id) > 0),
  member_id TEXT NOT NULL
    REFERENCES family_members (id) ON DELETE RESTRICT ON UPDATE RESTRICT,
  name TEXT NOT NULL CHECK (length(trim(name)) > 0),
  dose TEXT NOT NULL CHECK (length(trim(dose)) > 0),
  instructions TEXT,
  -- Daily reminder times: a JSON array of 'HH:MM' strings, at least one.
  reminder_times TEXT NOT NULL CHECK (json_valid(reminder_times)
    AND json_type(reminder_times) = 'array'
    AND json_array_length(reminder_times) > 0),
  start_date TEXT NOT NULL CHECK (length(start_date) = 10
    AND start_date GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'),
  -- Inclusive; null when the treatment has no planned end.
  end_date TEXT CHECK (end_date IS NULL OR (length(end_date) = 10
    AND end_date GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'
    AND end_date >= start_date)),
  -- Target of the composite key in dose_records.
  UNIQUE (id, member_id)
) STRICT AS MedicationRow;

CREATE INDEX medications_by_member ON medications (member_id);

-- Scheduled doses the user marked as taken or skipped.
CREATE TABLE dose_records (
  id TEXT NOT NULL PRIMARY KEY CHECK (length(id) > 0),
  member_id TEXT NOT NULL
    REFERENCES family_members (id) ON DELETE RESTRICT ON UPDATE RESTRICT,
  medication_id TEXT NOT NULL,
  -- The scheduled dose's local date and time, to the minute.
  scheduled_at TEXT NOT NULL CHECK (length(scheduled_at) = 26 AND scheduled_at GLOB
    '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:00.000000'),
  status TEXT NOT NULL CHECK (status IN ('taken', 'skipped')),
  recorded_at INTEGER NOT NULL,
  -- One record per scheduled dose.
  UNIQUE (medication_id, scheduled_at),
  -- The medication must belong to the same family member, so one member's
  -- history can never show up under another member.
  FOREIGN KEY (medication_id, member_id)
    REFERENCES medications (id, member_id)
    ON DELETE RESTRICT ON UPDATE RESTRICT
) STRICT AS DoseRecordRow;

CREATE INDEX dose_records_by_member ON dose_records (member_id, scheduled_at);

-- ---------------------------------------------------------------------------
-- Household sharing and two-way sync (added in version 4). Everything below
-- is bookkeeping for sharing selected children with a household. A user who
-- never creates or joins a household has empty tables and no tracking: the
-- triggers check sync_settings first. No key is stored here; identity and
-- household keys live in the OS secure storage (see SyncKeyStore).
-- ---------------------------------------------------------------------------

-- This device's sync identity and household link. At most one row.
CREATE TABLE sync_settings (
  id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
  -- Random, created on first use; names this device's change log.
  device_id TEXT NOT NULL CHECK (length(device_id) > 0),
  household_id TEXT CHECK (household_id IS NULL OR length(household_id) > 0),
  account_uid TEXT CHECK (account_uid IS NULL OR length(account_uid) > 0),
  role TEXT CHECK (role IS NULL OR role IN ('admin', 'member')),
  state TEXT NOT NULL DEFAULT 'off'
    CHECK (state IN ('off', 'joining', 'active', 'removed')),
  -- The invitation this device accepted, while it waits to be added.
  invite_id TEXT,
  last_sync_at INTEGER,
  -- Sequence number of the next change batch this device uploads.
  next_seq INTEGER NOT NULL DEFAULT 1 CHECK (next_seq >= 1),
  -- 1 only inside the transaction that applies changes from other devices,
  -- so those changes are not tracked as local ones.
  applying INTEGER NOT NULL DEFAULT 0 CHECK (applying IN (0, 1))
) STRICT AS SyncSettingsRow;

-- Children shared with the household. Only a "child" profile can be
-- shared, since that relation is the same on every parent's phone.
CREATE TABLE sync_shared_members (
  member_id TEXT NOT NULL PRIMARY KEY
    REFERENCES family_members (id) ON DELETE RESTRICT ON UPDATE RESTRICT,
  shared_at INTEGER NOT NULL
) STRICT AS SyncSharedMemberRow;

-- What this device knows about each shared record: its version vector, who
-- changed it last and when, whether it was deleted (a tombstone, kept so a
-- deleted record never comes back), and the content last exchanged (the
-- base of a three-way merge). member_id has no foreign key on purpose: a
-- tombstone outlives its family member.
CREATE TABLE sync_records (
  kind TEXT NOT NULL CHECK (kind IN ('member', 'appointment', 'question',
    'symptom', 'media', 'medication', 'dose', 'share')),
  sync_id TEXT NOT NULL CHECK (length(sync_id) > 0),
  local_id TEXT NOT NULL CHECK (length(local_id) > 0),
  member_id TEXT NOT NULL CHECK (length(member_id) > 0),
  version_vector TEXT NOT NULL CHECK (json_valid(version_vector)
    AND json_type(version_vector) = 'object'),
  updated_at INTEGER NOT NULL,
  updated_by TEXT NOT NULL CHECK (length(updated_by) > 0),
  deleted INTEGER NOT NULL CHECK (deleted IN (0, 1)),
  base TEXT CHECK (base IS NULL OR (json_valid(base)
    AND json_type(base) = 'object')),
  -- 1 while a change from another device waits for its parent record
  -- (e.g. a question whose appointment has not arrived yet).
  parked INTEGER NOT NULL DEFAULT 0 CHECK (parked IN (0, 1)),
  PRIMARY KEY (kind, sync_id)
) STRICT AS SyncRecordRow;

CREATE INDEX sync_records_by_local ON sync_records (kind, local_id);
CREATE INDEX sync_records_by_member ON sync_records (member_id);

-- Local changes not uploaded yet, filled by the triggers below.
-- change_count lets an upload clear only the changes it actually sent.
CREATE TABLE sync_pending (
  kind TEXT NOT NULL CHECK (kind IN ('member', 'appointment', 'question',
    'symptom', 'media', 'medication', 'dose', 'share')),
  sync_id TEXT NOT NULL CHECK (length(sync_id) > 0),
  local_id TEXT NOT NULL CHECK (length(local_id) > 0),
  change_count INTEGER NOT NULL DEFAULT 1 CHECK (change_count >= 0),
  PRIMARY KEY (kind, sync_id)
) STRICT AS SyncPendingRow;

-- Changes from another device that were not applied because they clash
-- with this device's data, or delete it. The user resolves each one; until
-- then the record keeps this device's version and is not uploaded.
CREATE TABLE sync_conflicts (
  kind TEXT NOT NULL CHECK (kind IN ('member', 'appointment', 'question',
    'symptom', 'media', 'medication', 'dose')),
  sync_id TEXT NOT NULL CHECK (length(sync_id) > 0),
  local_id TEXT NOT NULL CHECK (length(local_id) > 0),
  member_id TEXT NOT NULL CHECK (length(member_id) > 0),
  reason TEXT NOT NULL CHECK (reason IN ('edited', 'deleted', 'deletedHere')),
  local TEXT CHECK (local IS NULL OR (json_valid(local)
    AND json_type(local) = 'object')),
  remote TEXT CHECK (remote IS NULL OR (json_valid(remote)
    AND json_type(remote) = 'object')),
  remote_vector TEXT NOT NULL CHECK (json_valid(remote_vector)
    AND json_type(remote_vector) = 'object'),
  remote_updated_at INTEGER NOT NULL,
  remote_updated_by TEXT NOT NULL CHECK (length(remote_updated_by) > 0),
  fields TEXT NOT NULL DEFAULT '[]'
    CHECK (json_valid(fields) AND json_type(fields) = 'array'),
  detected_at INTEGER NOT NULL,
  PRIMARY KEY (kind, sync_id)
) STRICT AS SyncConflictRow;

-- The last change batch read from each device's log.
CREATE TABLE sync_cursors (
  device_id TEXT NOT NULL PRIMARY KEY CHECK (length(device_id) > 0),
  last_seq INTEGER NOT NULL CHECK (last_seq >= 0)
) STRICT AS SyncCursorRow;

-- Household members whose public keys this device verified (through the
-- invitation code or a membership attestation), so the server cannot swap
-- a key unnoticed.
CREATE TABLE sync_known_members (
  uid TEXT NOT NULL PRIMARY KEY CHECK (length(uid) > 0),
  public_key TEXT NOT NULL CHECK (length(public_key) > 0),
  role TEXT NOT NULL CHECK (role IN ('admin', 'member')),
  label TEXT
) STRICT AS SyncKnownMemberRow;

-- Only a child can be shared, and a shared profile stays a child.
CREATE TRIGGER sync_share_only_children BEFORE INSERT ON sync_shared_members
WHEN (SELECT relation FROM family_members WHERE id = NEW.member_id)
  IS NOT 'child'
BEGIN
  SELECT RAISE(ABORT, 'only a child profile can be shared');
END;

CREATE TRIGGER sync_shared_stays_child BEFORE UPDATE OF relation
ON family_members
WHEN NEW.relation <> 'child'
  AND EXISTS (SELECT 1 FROM sync_shared_members WHERE member_id = OLD.id)
BEGIN
  SELECT RAISE(ABORT, 'a shared profile stays a child');
END;

-- Change tracking: every insert, update and delete of a shared child's
-- record, or of a record already known to the household, is noted in
-- sync_pending, in the same transaction as the change itself.

CREATE TRIGGER sync_track_family_members_insert AFTER INSERT ON family_members
WHEN EXISTS (SELECT 1 FROM sync_settings
    WHERE household_id IS NOT NULL AND applying = 0)
  AND (EXISTS (SELECT 1 FROM sync_shared_members WHERE member_id = NEW.id)
    OR EXISTS (SELECT 1 FROM sync_records
      WHERE kind = 'member' AND sync_id = NEW.id))
BEGIN
  INSERT OR IGNORE INTO sync_pending (kind, sync_id, local_id, change_count)
    VALUES ('member', NEW.id, NEW.id, 0);
  UPDATE sync_pending SET change_count = change_count + 1, local_id = NEW.id
    WHERE kind = 'member' AND sync_id = NEW.id;
END;

CREATE TRIGGER sync_track_family_members_update AFTER UPDATE ON family_members
WHEN EXISTS (SELECT 1 FROM sync_settings
    WHERE household_id IS NOT NULL AND applying = 0)
  AND (EXISTS (SELECT 1 FROM sync_shared_members WHERE member_id = NEW.id)
    OR EXISTS (SELECT 1 FROM sync_shared_members WHERE member_id = OLD.id)
    OR EXISTS (SELECT 1 FROM sync_records
      WHERE kind = 'member' AND sync_id = NEW.id))
BEGIN
  INSERT OR IGNORE INTO sync_pending (kind, sync_id, local_id, change_count)
    VALUES ('member', NEW.id, NEW.id, 0);
  UPDATE sync_pending SET change_count = change_count + 1, local_id = NEW.id
    WHERE kind = 'member' AND sync_id = NEW.id;
END;

CREATE TRIGGER sync_track_family_members_delete AFTER DELETE ON family_members
WHEN EXISTS (SELECT 1 FROM sync_settings
    WHERE household_id IS NOT NULL AND applying = 0)
  AND (EXISTS (SELECT 1 FROM sync_shared_members WHERE member_id = OLD.id)
    OR EXISTS (SELECT 1 FROM sync_records
      WHERE kind = 'member' AND sync_id = OLD.id))
BEGIN
  INSERT OR IGNORE INTO sync_pending (kind, sync_id, local_id, change_count)
    VALUES ('member', OLD.id, OLD.id, 0);
  UPDATE sync_pending SET change_count = change_count + 1, local_id = OLD.id
    WHERE kind = 'member' AND sync_id = OLD.id;
END;

