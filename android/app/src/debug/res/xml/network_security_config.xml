<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Plain HTTP is allowed solely to the development
  machine as seen from the Android emulator (10.0.2.2) and to localhost,
  where the Firebase Local Emulator Suite runs. Everything else, and every
  release build, uses HTTPS only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
