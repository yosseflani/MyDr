rules_version = '2';

// MyDr cloud backup and household media. Every object is already
// encrypted on the device (backups with the user's recovery key, household
// media with the household key); these rules make sure each account can
// reach only its own backup folder and its own households' media, and
// nothing else exists.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/backups/{path=**} {
      // Read covers both downloading and listing.
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      // New objects only: a backup is never changed after upload. The
      // existing-object check also holds where an overwrite is evaluated
      // as a create.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && resource == null
        && request.resource.size <= 200 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream';
      allow update: if false;
    }

    // Household sharing: photos and videos encrypted on the device with the
    // household key. Only members of the household (a Firestore document)
    // may read or add them; nothing is ever overwritten or deleted here.
    match /households/{hid}/media/{object} {
      allow read: if request.auth != null
        && firestore.exists(/databases/(default)/documents/households/$(hid)/members/$(request.auth.uid));
      allow create: if request.auth != null
        && firestore.exists(/databases/(default)/documents/households/$(hid)/members/$(request.auth.uid))
        && resource == null
        && request.resource.size <= 200 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream';
      allow update, delete: if false;
    }

    match /{other=**} {
      allow read, write: if false;
    }
  }
}
